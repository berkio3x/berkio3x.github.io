---
import Split from '../layouts/Split.astro';
import { PROJECTS } from '../config';
---
<Split title="Work" eyebrow="02 / Work" description="Selected projects.">
  <Fragment slot="aside">
    <h1 class="display">Things I built, shipped or <em>kept afloat</em>.</h1>
    <p class="lede">A short list. Each one taught me something I still use.</p>
  </Fragment>

  <ul class="entries">
    {PROJECTS.map((p, i) => (
      <li>
        <a class="entry" href={p.href} target="_blank" rel="noopener">
          <span class="entry-no">{String(i + 1).padStart(2, '0')}</span>
          <span class="entry-title">{p.name}</span>
          <span class="entry-side">{p.year}</span>
          <span class="entry-sub">
            <span>{p.summary}</span>
          </span>
          <span class="entry-sub">
            <span>{p.role}</span>
            {p.tags.map((t) => <span class="chip">{t}</span>)}
          </span>
        </a>
      </li>
    ))}
  </ul>
</Split>
