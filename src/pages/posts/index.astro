---
import Split from '../../layouts/Split.astro';
import { getPosts } from '../../lib/posts';
import { formatDate, readingMinutes, url } from '../../lib/url';

const posts = await getPosts();
---
<Split title="Posts" eyebrow="03 / Posts" description="Notes and essays.">
  <Fragment slot="aside">
    <h1 class="display"><em>Posts</em>: notes from the work.</h1>
    <p class="lede">{posts.length} entries. Follow along with <a href={url('rss.xml')}>RSS</a>.</p>
  </Fragment>

  <ul class="entries">
    {posts.map((p, i) => {
      const min = readingMinutes(p.body ?? '');
      return (
        <li>
          <a class="entry" href={url(`posts/${p.id}/`)}>
            <span class="entry-no">No.{String(posts.length - i).padStart(2, '0')}</span>
            <span class="entry-title">{p.data.title}</span>
            <time class="entry-side" datetime={p.data.date.toISOString().slice(0, 10)}>{formatDate(p.data.date)}</time>
            <span class="entry-sub">
              <span>{p.data.description}</span>
            </span>
            <span class="entry-sub">
              <span class="meter" title={`${min} min read`}>
                {Array.from({ length: 8 }, (_, k) => <i class={k < min ? 'on' : ''} />)}
              </span>
              <span>{min} min</span>
              {p.data.tags.map((t) => <span class="chip">{t}</span>)}
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</Split>
