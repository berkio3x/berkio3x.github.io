---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getPosts } from '../../lib/posts';
import { formatDate, readingMinutes, url } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, number: posts.length - i, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, number, newer, older } = Astro.props;
const { Content } = await render(post);
const minutes = readingMinutes(post.body ?? '');
---
<Article title={post.data.title} description={post.data.description}>
  <Fragment slot="hero">
    <a class="back" href={url('posts/')}>← Logbook</a>
    <p class="eyebrow">No.{String(number).padStart(2, '0')}</p>
    <h1 class="display article-title">{post.data.title}</h1>
    <p class="post-meta">
      <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
      <span>{minutes} min read</span>
      {post.data.tags.map((t) => <span class="chip">{t}</span>)}
    </p>
  </Fragment>

  <div class="progress" aria-hidden="true"></div>
  <p class="article-lede">{post.data.description}</p>
  <div class="prose">
    <Content />
  </div>

  <nav class="post-foot" aria-label="More posts">
    {older ? <a href={url(`posts/${older.id}/`)}>← {older.data.title}</a> : <span></span>}
    {newer ? <a href={url(`posts/${newer.id}/`)}>{newer.data.title} →</a> : <span></span>}
  </nav>
</Article>

<script>
  function bindProgress() {
    const bar = document.querySelector<HTMLElement>('.progress');
    if (!bar) return;
    const update = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      bar.style.setProperty('--p', String(max > 0 ? Math.min(1, scrollY / max) : 0));
    };
    update();
    addEventListener('scroll', update, { passive: true });
    document.addEventListener('astro:before-swap', () => removeEventListener('scroll', update), { once: true });
  }
  document.addEventListener('astro:page-load', bindProgress);
</script>
